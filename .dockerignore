# ──────────────────────────────────────────────────────────────────
#  .dockerignore
#  Lists files/directories that Docker should NOT copy into the
#  build context. Keeps the build fast and the image clean.
# ──────────────────────────────────────────────────────────────────

# Compiled class files (re-compiled inside the builder stage)
out/

# IDE project files
.idea/
*.iml
.vscode/
*.code-workspace

# OS-generated junk
.DS_Store
Thumbs.db

# Git metadata
.git/
.gitignore

# Shell scripts (not needed inside the container)
run.sh

# Any zip archives
*.zip

# README / docs (optional – remove if you want them in the image)
*.md
